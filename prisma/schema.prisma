// ============================================================================
// KODU PROJECT CONTROLS AI — MULTI-TENANT PRISMA SCHEMA v2.0
// Base: tu schema real de producción (Abacus/Next.js) + capa Company multi-tenant
// Target: Supabase (PostgreSQL)
// ----------------------------------------------------------------------------
// QUÉ CAMBIÓ vs tu schema original:
//   + Nuevo modelo Company (raíz del tenant — cada GC es una company)
//   + User.companyId        → un usuario pertenece a una company
//   + Project.companyId     → un proyecto pertenece a una company (no solo a un user)
//   + Índices por companyId para aislamiento y rendimiento
//   * TODO lo demás se mantiene 1:1 con tu modelo real (CO, PayApp, Budget, CPM)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANT ROOT ──────────────────────────────────────────────────────
model Company {
  id            String    @id @default(cuid())
  name          String                              // "The Project Delivery Group LLC"
  address       String?                             // calle y número (reportes PDF)
  addressCity   String?                             // ciudad, estado, CP
  phone         String?
  website       String?
  license       String?                             // n.º de licencia (ej. CGC...)
  logoUrl       String?
  // Branding tokens (tu sistema visual PDG: navy / gold / cream)
  brandPrimary  String    @default("#1B365D")       // dark navy
  brandAccent   String    @default("#D4A843")       // gold
  brandCream    String    @default("#F7F6F2")
  plan          String    @default("starter")       // starter | pro | enterprise
  users         User[]
  projects      Project[]
  invites       UserInvite[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model User {
  id            String    @id @default(cuid())
  companyId     String?                              // ← NUEVO: tenant link
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("user")          // owner | pm | estimator | viewer
  locale        String    @default("en")            // en | es — UI and export language
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  memberships   ProjectMember[]
  projectAccess ProjectAccess[]
  invitesSent   UserInvite[]      @relation("InviteCreator")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
}

// ============================================================
// PASO 3 — Invitaciones con roles y acceso por proyecto
// Roles: admin | pm | superintendent | owner | subcontractor
// (el "architect" nunca recibe cuenta: responde por enlace seguro)
// ============================================================

// Membresía de un usuario a la empresa (companyId del User) + alcance por proyecto.
// projectId NULL = miembro de empresa con acceso según su rol a todos los proyectos.
// projectId SET  = acceso limitado a ese proyecto (owner / subcontractor).
model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String   @default("viewer") // admin | pm | superintendent | owner | subcontractor | viewer
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// Invitación pendiente: el invitado crea su clave y se une a la empresa del invitador.
model UserInvite {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  role      String    @default("viewer")
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token     String    @unique
  status    String    @default("pending") // pending | accepted | revoked
  invitedBy String?
  inviter   User?     @relation("InviteCreator", fields: [invitedBy], references: [id], onDelete: SetNull)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([companyId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id              String           @id @default(cuid())
  companyId       String?                            // ← NUEVO: tenant link
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectNumber   String
  projectName     String
  client          String
  location        String?
  contractAmount  Float            @default(0)
  startDate       DateTime?
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  changeOrders    ChangeOrder[]
  rfis            RFI[]
  payApplications PayApplication[]
  budgets         Budget[]
  schedules       Schedule[]
  submittals      Submittal[]
  buyoutItems     BuyoutItem[]
  contacts        ProjectContact[]
  members         ProjectMember[]
  invites         UserInvite[]
  sitePhotos      SitePhoto[]
  dailyLogs       DailyLog[]
  lienWaivers     LienWaiver[]
  subInvoices     SubInvoice[]
  punchItems      PunchItem[]
  punchSignoffs   PunchAreaSignoff[]
  closeoutItems   CloseoutItem[]
  planSets        PlanSet[]
  planSheets      PlanSheet[]
  accessKey       String?                            // clave de entrada al proyecto (la define admin/pm)
  projectAccess   ProjectAccess[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([projectNumber])
}

model ChangeOrder {
  id                  String             @id @default(cuid())
  projectId           String
  project             Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  corNumber           String
  sequence            Int
  date                DateTime           @default(now())
  description         String
  subcontractor       String?
  status              String             @default("Pending")
  approvalDate        DateTime?
  csiCode             String?
  subtotal            Float              @default(0)
  overheadProfit      Float              @default(0)
  generalLiability    Float              @default(0)
  salesTax            Float              @default(0)
  totalAmount         Float              @default(0)
  drawingRef          String?            // referencia a plano (texto)
  planSheetId         String?            // vínculo Plan Room
  reasonForChange     String?            @db.Text
  reasonsParticular   String?            @db.Text
  marketAnalysisNotes String?            @db.Text
  pdfCloudPath        String?
  pdfIsPublic         Boolean            @default(false)
  subPdfCloudPath     String?
  subPdfIsPublic      Boolean            @default(false)
  ownerName           String?            // approver contact (external)
  ownerEmail          String?
  externalToken       String?            @unique // magic link para aprobar/rechazar sin login
  decidedBy           String?            // quién aprobó/rechazó (incluye externos)
  notes               String?
  lineItems           LineItem[]
  marketComparisons   MarketComparison[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([corNumber])
}

model LineItem {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  description   String
  productCode   String?
  quantity      Float       @default(1)
  unit          String      @default("EA")
  unitPrice     Float       @default(0)
  total         Float       @default(0)
  isMaterial    Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([changeOrderId])
}

model ProjectContact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      String   // Project Manager | Superintendent | Architect | Subcontractor | Owner | Designer | Engineer
  company   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([role])
  @@index([email])
}

/// Jobsite photos — daily progress, issues, safety (Photo Site)
model SitePhoto {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cloudStoragePath String
  fileName         String
  fileType         String?
  caption          String?   @db.Text
  area             String?
  trade            String?
  tag              String    @default("progress") // progress | issue | safety | delivery | other
  takenAt          DateTime  @default(now())
  uploadedBy       String?
  uploadedByEmail  String?
  latitude         Float?
  longitude        Float?
  dailyLogId       String?
  dailyLog         DailyLog? @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId])
  @@index([takenAt])
  @@index([tag])
  @@index([dailyLogId])
}

/// Superintendent daily field report
model DailyLog {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logDate       DateTime
  authorName    String
  authorEmail   String?
  weather       String?
  temperature   String?
  workPerformed String?     @db.Text
  crewNotes     String?     @db.Text
  deliveries    String?     @db.Text
  delays        String?     @db.Text
  status        String      @default("Draft") // Draft | Submitted | Approved
  approvedBy    String?
  approvedAt    DateTime?
  photos        SitePhoto[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([projectId, logDate])
  @@index([projectId])
  @@index([logDate])
  @@index([status])
}

model RFI {
  id                 String          @id @default(cuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rfiNumber          String
  sequence           Int
  subject            String
  question           String          @db.Text
  discipline         String?
  drawingReference   String?
  planSheetId      String?          // vínculo Plan Room (texto histórico conservado)
  specReference      String?
  priority           String          @default("Normal")
  status             String          @default("Open")
  submittedBy        String
  submittedByRole    String?
  submittedByEmail   String?
  assignedTo         String
  assignedToRole     String?
  assignedToEmail    String?
  superintendentName String?
  superintendentEmail String?
  requestingSubName  String?
  requestingSubEmail String?
  ballInCourt        String?         // name of who must act now
  ballInCourtRole    String?
  externalToken      String?         @unique // magic link for external response (no login)
  decisionToken      String?         @unique // magic link for creator to close from email (no login)
  dateSubmitted      DateTime        @default(now())
  dateDue            DateTime?
  daysToRespond      Int             @default(7)
  responseText       String?         @db.Text
  responseBy         String?
  responseDate       DateTime?
  costImpact         String          @default("TBD")
  scheduleImpact     String          @default("TBD")
  scheduleImpactDays Int?
  notes              String?         @db.Text
  attachments        RFIAttachment[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([rfiNumber])
  @@index([assignedTo])
}

model RFIAttachment {
  id               String   @id @default(cuid())
  rfiId            String
  rfi              RFI      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  fileName         String
  fileType         String?
  cloudStoragePath String
  isPublic         Boolean  @default(false)
  attachmentType   String   @default("question")
  createdAt        DateTime @default(now())

  @@index([rfiId])
}

model Submittal {
  id              String               @id @default(cuid())
  projectId       String
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittalNumber String
  sequence        Int
  title           String
  description     String?              @db.Text
  submittalType   String               @default("Shop Drawing")
  specSection     String?
  planSheetId      String?          // vínculo Plan Room (texto histórico conservado)
  subcontractor   String?
  priority        String               @default("Normal")
  status          String               @default("Draft")
  requiredDate    DateTime?
  submittedBy     String?
  submittedByEmail String?
  submittedDate   DateTime?
  assignedTo      String?
  assignedToRole  String?
  assignedToEmail String?
  reviewerEmail   String?
  subcontractorEmail String?
  superintendentName String?
  superintendentEmail String?
  ballInCourt     String?
  ballInCourtRole String?
  reviewedBy      String?
  reviewedDate    DateTime?
  externalToken   String?              @unique // magic link para respuesta externa (sin login)
  decisionToken   String?              @unique // magic link para que el creador cierre desde el correo (sin login)
  responseText    String?              @db.Text
  responseBy      String?
  responseDate    DateTime?
  notes           String?              @db.Text
  attachments     SubmittalAttachment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([submittalNumber])
}

model SubmittalAttachment {
  id               String    @id @default(cuid())
  submittalId      String
  submittal        Submittal @relation(fields: [submittalId], references: [id], onDelete: Cascade)
  fileName         String
  fileType         String?
  cloudStoragePath String
  isPublic         Boolean   @default(false)
  createdAt        DateTime  @default(now())

  @@index([submittalId])
}

/// Buyout / Contract Tracking — one editable matrix per project (trades + CORs mixed)
model BuyoutItem {
  id                        String    @id @default(cuid())
  projectId                 String
  project                   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder                 Int       @default(0)
  lineType                  String    @default("Trade") // Division | Trade | COR | GC | Allowance
  divisionCode              String?
  trade                     String
  status                    String    @default("Not Started")
  // Money
  proposalAmount            Float     @default(0)
  proposalDetails           String?   @db.Text
  potentialBuyoutAmount     Float     @default(0)
  potentialBuyoutDetails    String?   @db.Text
  contractedValue           Float     @default(0)
  pendingCor                Float     @default(0)
  changeOrders              Float     @default(0)
  totalValueBudget          Float     @default(0)
  totalByChapter            Float?
  cashFlowInvested          Float     @default(0)
  // Schedule / procurement
  targetContractDate        DateTime?
  actualContractDate        DateTime?
  dateSubOnSite             DateTime?
  productLeadTimeDays       Int?
  approvalLeadTimeDays      Int?
  finalOwnerApprovalDate    DateTime?
  finalSubmissionApprovalDate DateTime?
  forecastBidDate           DateTime?
  forecastContractDate      DateTime?
  awardDate                 DateTime?
  subcontractor             String?
  notes                     String?   @db.Text
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([projectId])
  @@index([lineType])
  @@index([status])
  @@index([sortOrder])
}

model PayApplication {
  id                      String           @id @default(cuid())
  projectId               String
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicationNumber       Int
  applicationDate         DateTime
  periodFrom              DateTime
  periodTo                DateTime
  status                  String           @default("Draft")
  ownerName               String?
  ownerAddress            String?
  ownerCity               String?
  architectName           String?
  architectAddress        String?
  architectCity           String?
  contractDate            DateTime?
  contractFor             String?
  contractForm            String?
  opPercent               Float            @default(0.06)
  glPercent               Float            @default(0.015)
  contingencyPercent      Float            @default(0.10)
  retainagePercent        Float            @default(0.10)
  retainageContPercent    Float            @default(0)
  constructionSubtotal    Float            @default(0)
  originalContractSum     Float            @default(0)
  glInsuranceAmount       Float            @default(0)
  advancePayments         Float            @default(0)
  advancePaymentsLabel    String?
  directPayments          Float            @default(0)   // 7b: acumulado PREVIO — lo calcula el sistema (PA anterior) o se siembra una vez
  directPaymentsDeduction Float            @default(0)   // legacy (fallback)
  directPaymentsCurrent   Float            @default(0)   // 7c: pago directo del Owner en ESTE período (deducción línea 8)
  directPaymentsLabel     String?
  previousCertificates    Float            @default(0)
  g702NetChange           Float?
  g702ContractSumToDate   Float?
  g702TotalCompleted      Float?
  g702Retainage           Float?
  g702TotalEarned         Float?
  g702CurrentPaymentDue   Float?
  g702BalanceToFinish     Float?
  contractorPrinted       String?
  contractorTitle         String?
  ownerPrinted            String?
  notes                   String?          @db.Text
  lineItems               PayAppLineItem[]
  lienWaivers             LienWaiver[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([projectId, applicationNumber])
  @@index([projectId])
  @@index([status])
}

model PayAppLineItem {
  id                String         @id @default(cuid())
  payApplicationId  String
  payApplication    PayApplication @relation(fields: [payApplicationId], references: [id], onDelete: Cascade)
  sortOrder         Int            @default(0)
  itemNumber        String         @default("")
  sectionCode       String         @default("")
  sectionTitle      String         @default("")
  description       String
  subVendor         String         @default("")
  scheduledValue    Float          @default(0)
  budgetRealloc     Float          @default(0)
  previousChanges   Float          @default(0)
  currentChanges    Float          @default(0)
  previousCompleted Float          @default(0)
  thisCompleted     Float          @default(0)
  retainage         Float          @default(0)
  isSection         Boolean        @default(false)
  isBelowLine       Boolean        @default(false)
  isFee             Boolean        @default(false)
  createdAt         DateTime       @default(now())

  @@index([payApplicationId])
  @@index([sortOrder])
}

model Budget {
  id                   String             @id @default(cuid())
  projectId            String
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version              String             @default("1.0")
  budgetDate           DateTime           @default(now())
  totalACSF            Float?
  sfRate               Float?
  constructionSubtotal Float              @default(0)
  furnishingsSubtotal  Float              @default(0)
  subTotalAll          Float              @default(0)
  opPercent            Float              @default(0.08)
  glPercent            Float              @default(0.02)
  contingencyPercent   Float              @default(0.10)
  opAmount             Float              @default(0)
  glAmount             Float              @default(0)
  contingencyAmount    Float              @default(0)
  grandTotal           Float              @default(0)
  exclusions           String?            @db.Text
  assumptions          String?            @db.Text
  notes                String?            @db.Text
  status               String             @default("Active")
  lineItems            BudgetLineItem[]
  detailItems          BudgetDetailItem[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([projectId])
}

model BudgetLineItem {
  id             String   @id @default(cuid())
  budgetId       String
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  sortOrder      Int      @default(0)
  divisionCode   String   @default("")
  itemNumber     String   @default("")
  description    String
  subVendor      String   @default("")
  scheduledValue Float    @default(0)
  currentChanges Float    @default(0)
  revisedValue   Float    @default(0)
  percentTotal   Float    @default(0)
  isSection      Boolean  @default(false)
  isSubtotal     Boolean  @default(false)
  isFee          Boolean  @default(false)
  isBelowLine    Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([budgetId])
  @@index([sortOrder])
}

model BudgetDetailItem {
  id             String   @id @default(cuid())
  budgetId       String
  budget         Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  sheetName      String
  sortOrder      Int      @default(0)
  status         String   @default("")
  itemCode       String   @default("")
  description    String
  quantity       Float    @default(0)
  unit           String   @default("")
  laborUnit      Float    @default(0)
  laborTotal     Float    @default(0)
  materialUnit   Float    @default(0)
  materialTotal  Float    @default(0)
  equipmentUnit  Float    @default(0)
  equipmentTotal Float    @default(0)
  subUnit        Float    @default(0)
  subTotal       Float    @default(0)
  totalUnitCost  Float    @default(0)
  totalCost      Float    @default(0)
  isHeader       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([budgetId])
  @@index([sheetName])
}

model MarketComparison {
  id              String      @id @default(cuid())
  changeOrderId   String
  changeOrder     ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  itemDescription String
  subQuote        Float       @default(0)
  marketLow       Float?      @default(0)
  marketHigh      Float?      @default(0)
  marketAverage   Float       @default(0)
  variancePercent Float       @default(0)
  assessment      String?
  source          String?
  createdAt       DateTime    @default(now())

  @@index([changeOrderId])
}

// ─── CPM Schedule Module ────────────────────────────────────────────────────
model Schedule {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision      String             @default("Rev.1")
  dataDate      DateTime           @default(now())
  projectStart  DateTime?
  projectFinish DateTime?
  tcoDate       DateTime?
  notes         String?            @db.Text
  status        String             @default("Active")
  activities    ScheduleActivity[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([projectId])
  @@index([status])
}

model ScheduleActivity {
  id                String    @id @default(cuid())
  scheduleId        String
  schedule          Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  sortOrder         Int       @default(0)
  activityId        String    @default("")
  activityName      String
  activityType      String    @default("task")
  originalDuration  Int       @default(0)
  remainingDuration Int       @default(0)
  percentComplete   Float     @default(0)
  startDate         DateTime?
  finishDate        DateTime?
  actualStart       DateTime?
  actualFinish      DateTime?
  status            String    @default("pend")
  isCritical        Boolean   @default(false)
  isMilestone       Boolean   @default(false)
  notes             String?   @db.Text
  wbsCode           String    @default("")
  predecessors      String?
  successors        String?
  calendarDays      Boolean   @default(false)
  floatDays         Int       @default(0)
  costLoaded        Float     @default(0)
  resourceName      String    @default("")
  isLookAhead       Boolean   @default(false)
  parentActivityId  String?
  createdAt         DateTime  @default(now())

  @@index([scheduleId])
  @@index([sortOrder])
  @@index([isCritical])
  @@index([status])
}

// ============================================================
// LIEN WAIVERS — exenciones de gravamen de subs/proveedores
// ------------------------------------------------------------
// Flujo: el GC crea el waiver (por proyecto, opcionalmente ligado
// a una Pay Application) → se envía al sub por correo con enlace
// seguro → el sub descarga la forma, la firma y la sube → el GC
// la aprueba. Estados: Pending → Sent → Received → Approved.
// Tipos: conditional/unconditional × progress/final (estándar USA).
// ============================================================
model LienWaiver {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payApplicationId String?
  payApplication   PayApplication? @relation(fields: [payApplicationId], references: [id], onDelete: SetNull)
  subcontractor    String
  subEmail         String?
  waiverType       String          @default("conditional_progress") // conditional_progress | unconditional_progress | conditional_final | unconditional_final
  amount           Float           @default(0)
  throughDate      DateTime?
  status           String          @default("Pending") // Pending | Sent | Received | Approved
  fileUrl          String?
  fileName         String?
  externalToken    String?         @unique
  sentAt           DateTime?
  receivedAt       DateTime?
  notes            String?         @db.Text
  createdByName    String?
  createdByEmail   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([projectId])
  @@index([payApplicationId])
}

// ============================================================
// SUB INVOICES — facturas/pay apps que los subs envían al GC
// ------------------------------------------------------------
// Flujo PDG: el sub manda su invoice/pay app en PDF → el PM lo sube,
// asigna el COST CODE de la lista del proyecto y el NETO aprobado
// (retainage automático, editable) → koduPM ESTAMPA en el PDF la línea
// roja "Project N, Cost code: X, Net Payment: $Y" → se envía a
// contabilidad por correo. Reemplaza la edición manual del PDF.
// ============================================================
model SubInvoice {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor    String                                  // nombre del sub (texto libre o del directorio)
  invoiceNumber    String?                                 // # de invoice/pay app del sub
  description      String?                                 // concepto del trabajo
  grossAmount      Float     @default(0)                   // monto bruto del invoice
  retainagePercent Float     @default(0.05)                // % retención (default 5%)
  netAmount        Float     @default(0)                   // neto aprobado por el PM (calculado, editable)
  costCode         String?                                 // código de la lista del proyecto (ej "32 39 13")
  costCodeLabel    String?                                 // descripción del cost code
  fileUrl          String?                                 // PDF ORIGINAL del sub
  fileName         String?
  stampedFileUrl   String?                                 // PDF SELLADO con la línea roja
  stampedFileName  String?
  status           String    @default("Pending")           // Pending | Stamped | Sent
  sentToEmail      String?                                 // correo de contabilidad al que se envió
  sentAt           DateTime?
  notes            String?   @db.Text
  createdByName    String?
  createdByEmail   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============================================================
// PUNCH LIST — ítems de pendientes/corrección de cierre
// ------------------------------------------------------------
// Flujo (estilo Excel PDG Arena Madness): el GC camina el proyecto
// ÁREA por ÁREA y crea ítems (deficiencia + acción correctiva, foto,
// trade → sub) → asigna al sub por correo con enlace seguro → el sub
// marca "Ready for Review" (foto de la corrección) → SOLO el GC
// verifica y cierra (two-step closeout: nadie cierra su propio trabajo).
// Prioridad: A = Life Safety/TCO (vence 5 días hábiles, bloquea cierre),
// B = Functional (10 días), C = Cosmetic (10 días).
// Si el sub no responde: Disputed + backCharge (AIA A201 §2.5 y 6.3).
// ============================================================
model PunchItem {
  id                  String    @id @default(cuid())
  projectId           String
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  itemNumber          Int
  title               String
  description         String?   @db.Text
  location            String?
  planSheetId         String?                        // vínculo Plan Room (plano de referencia)
  pinX                Float?                         // pin en el plano: X relativo (0-1)
  pinY                Float?                         // pin en el plano: Y relativo (0-1)
  trade               String?
  assignedToName      String?
  assignedToEmail     String?
  priority            String    @default("B")      // A (Life Safety/TCO) | B (Functional) | C (Cosmetic)
  status              String    @default("Open")   // Open | In Progress | Ready for Review | Completed | Disputed
  dueDate             DateTime?
  area                String?                        // área predefinida del proyecto (walkthrough ordenado)
  correctiveAction    String?   @db.Text             // acción correctiva requerida (separada de la deficiencia)
  identifiedBy        String?                        // quién lo encontró en el walk
  backCharge          Float?                         // monto de back-charge si está Disputed
  photoUrl            String?
  photoName           String?
  completionPhotoUrl  String?
  completionPhotoName String?
  externalToken       String?   @unique
  sentAt              DateTime?
  completedAt         DateTime?
  completedByName     String?
  notes               String?   @db.Text
  createdByName       String?
  createdByEmail      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============================================================
// PUNCH AREA SIGNOFF — aceptación de área (soporte AIA G704)
// ------------------------------------------------------------
// Cuando TODOS los ítems de un área están Completed, el área se
// "firma": queda registro de quién (Super, PM, Owner's Rep) y
// cuándo. Esas firmas por área respaldan el Certificate of
// Substantial Completion (AIA G704). Si se reabre un ítem del
// área, la firma debe deshacerse manualmente (Unlock) para
// mantener la honestidad del registro.
// ============================================================
model PunchAreaSignoff {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  area          String
  superName     String?
  pmName        String?
  ownerRepName  String?
  signedByName  String?
  signedByEmail String?
  remarks       String?  @db.Text
  signedAt      DateTime @default(now())

  @@unique([projectId, area])
  @@index([projectId])
}

// ============================================================
// CLOSEOUT — entregables documentales de cierre de proyecto
// ------------------------------------------------------------
// Tracker de documentos de closeout (estilo hoja CLOSEOUT del
// Excel PDG Arena Madness): G704, affidavit FL §713, waivers
// finales, permisos, certificados life safety, TAB, as-builts,
// O&M, garantías, llaves, training, utilidades. Algunos los
// entregan los subs — se solicitan con enlace seguro (magic link)
// igual que los lien waivers. Estados: Pending → Requested →
// Received → Verified.
// ============================================================
model CloseoutItem {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder      Int       @default(0)
  category       String    // CONTRACTUAL / FL LIEN LAW / PERMITS / LIFE SAFETY / MEP / DOCUMENTS / TURNOVER
  deliverable    String
  responsible    String?
  status         String    @default("Pending") // Pending | Requested | Received | Verified
  dateReceived   DateTime?
  fileUrl        String?
  fileName       String?
  externalToken  String?   @unique
  requestedTo    String?
  requestedAt    DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([projectId])
}

/// ─── PLAN ROOM (drawing log con control de revisiones) ────────────────────

model PlanSet {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String      // "Contract Drawings", "Permit Set", "Addendum 2"…
  setType   String      @default("Original") // Original | Permit | Addendum | ASI | Revision | Other
  issueDate DateTime?
  notes     String?
  sortOrder Int         @default(0)
  sheets    PlanSheet[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([projectId])
}

model PlanSheet {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planSetId   String?
  planSet     PlanSet?       @relation(fields: [planSetId], references: [id], onDelete: SetNull)
  sheetNumber String         // "A-101"
  title       String         // "First Floor Plan"
  discipline  String?        // auto por la letra del número: Architectural, Structural…
  notes       String?
  revisions   PlanRevision[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([projectId, sheetNumber])
  @@index([projectId])
  @@index([planSetId])
}

model PlanRevision {
  id               String    @id @default(cuid())
  planSheetId      String
  planSheet        PlanSheet @relation(fields: [planSheetId], references: [id], onDelete: Cascade)
  label            String    // "Original", "Permit", "Rev A", "Rev B"…
  revisionDate     DateTime?
  fileUrl          String?
  fileName         String?
  fileIsPublic     Boolean   @default(false)
  isCurrent        Boolean   @default(true) // la revisión vigente (una por plano)
  uploadedByName   String?
  uploadedByEmail  String?
  notes            String?
  createdAt        DateTime  @default(now())

  @@index([planSheetId])
}


// ============================================================
// ACCESO POR PROYECTO CON CLAVE (v22)
// Regla del cliente: entrar al software muestra SOLO los proyectos;
// cada proyecto requiere su clave de entrada para desbloquearse.
// - admin / owner / pm  → ven y entran a TODO (gestión)
// - superintendent / viewer / etc. → solo proyectos desbloqueados:
//   a) membresía directa (ProjectMember), o
//   b) clave correcta ingresada una vez → queda guardada aquí
// ============================================================
model ProjectAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}
